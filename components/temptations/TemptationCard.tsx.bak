'use client'

import { useState } from 'react'
import Image from 'next/image'
import { Button } from '@/components/ui/Button'

interface Fragrance {
  id: string
  name: string
  brand: string
  image_url?: string
  family?: string
}

interface TemptationCardProps {
  fragrance: Fragrance
  temptationId: string
  triggerReason?: 'repeat_revisit' | 'wishlist_age' | 'blind_rank_match'
  onDismiss: () => void
  onAction: (action: 'viewed' | 'wishlisted' | 'bought') => Promise<void>
}

function getTriggerCopy(reason?: string): string {
  if (!reason) return 'This scent might be your next move.'
  if (reason === 'repeat_revisit') return 'You've viewed this 5 times...'
  if (reason === 'wishlist_age') return 'This has been in your wishlist for 2+ weeks.'
  if (reason === 'blind_rank_match') return 'Your blind pick was this one.'
  return 'This scent caught your eye.'
}

export default function TemptationCard({
  fragrance,
  temptationId,
  triggerReason,
  onDismiss,
  onAction,
}: TemptationCardProps) {
  const [isLoading, setIsLoading] = useState(false)
  const [isDismissed, setIsDismissed] = useState(false)

  if (isDismissed) return null

  const handleAction = async (action: 'viewed' | 'wishlisted' | 'bought') => {
    setIsLoading(true)
    try {
      await onAction(action)
      if (action === 'dismissed') {
        setIsDismissed(true)
      }
    } finally {
      setIsLoading(false)
    }
  }

  const handleDismiss = async () => {
    setIsLoading(true)
    try {
      onDismiss()
      setIsDismissed(true)
    } finally {
      setIsLoading(false)
    }
  }

  return (
    <div
      className="fixed bottom-24 right-4 z-40 max-w-sm rounded-xl border border-amber-200/30 bg-gradient-to-br from-amber-50 to-orange-50 shadow-lg backdrop-blur-sm dark:from-amber-950/20 dark:to-orange-950/20 dark:border-amber-700/30 p-4 space-y-4 animate-in slide-in-from-bottom-4 duration-300"
      style={{
        background: 'var(--aura-surface, oklch(0.18 0.04 60 / 0.6))',
        border: '1px solid var(--aura-border, oklch(0.45 0.06 60 / 0.3))',
      }}
    >
      {/* Fragrance Image & Name */}
      <div className="flex gap-3">
        {fragrance.image_url && (
          <div className="relative w-16 h-20 flex-shrink-0 rounded-lg overflow-hidden">
            <Image
              src={fragrance.image_url}
              alt={fragrance.name}
              fill
              className="object-cover"
              unoptimized={!fragrance.image_url.startsWith('http')}
            />
          </div>
        )}
        <div className="flex-1 min-w-0">
          <p className="font-instrument-italic text-sm text-amber-900/60 dark:text-amber-200/60">
            {getTriggerCopy(triggerReason)}
          </p>
          <h3 className="font-semibold text-base text-text truncate mt-1">
            {fragrance.name}
          </h3>
          <p className="text-sm text-text-muted">{fragrance.brand}</p>
        </div>
      </div>

      {/* Actions */}
      <div className="flex gap-2">
        <Button
          onClick={() => handleAction('wishlisted')}
          disabled={isLoading}
          variant="secondary"
          size="sm"
          className="flex-1 text-xs"
        >
          Wishlist
        </Button>
        <Button
          onClick={() => handleAction('viewed')}
          disabled={isLoading}
          variant="secondary"
          size="sm"
          className="flex-1 text-xs"
        >
          View
        </Button>
        <Button
          onClick={() => handleAction('bought')}
          disabled={isLoading}
          variant="primary"
          size="sm"
          className="flex-1 text-xs"
        >
          Buy
        </Button>
        <button
          onClick={handleDismiss}
          disabled={isLoading}
          className="px-2 py-2 text-xs text-text-muted hover:text-text transition-colors"
          aria-label="Maybe later"
          title="Maybe later"
        >
          ⋮
        </button>
      </div>
    </div>
  )
}
