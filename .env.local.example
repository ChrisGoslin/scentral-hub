# Open Beta — free for first 100 users, no Stripe/paywall yet
NEXT_PUBLIC_BETA_USER_LIMIT=100
NEXT_PUBLIC_BETA_MODE=true

# Supabase credentials for data scripts (enrich-images.mjs, etc.)
# NEVER commit actual credentials — .env.local is gitignored
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# Firecrawl is used only by back-office enrichment scripts, never by the live app.
# Optional when firecrawl CLI is already logged in on this Mac.
FIRECRAWL_API_KEY=fc-your-firecrawl-key-here
