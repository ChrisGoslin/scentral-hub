# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/e2e-report/
*.tracezip
/.playwright-cli/
/output/

# next.js
/.next/
/.next.preverify-*/
/.next.preclean-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sync/orchestrator artifacts — never commit
.tmp.driveupload/
.launch-logs/

# import data — large CSV files, never commit
scripts/data/

# supabase CLI temp files
supabase/.temp/

# Sentry Config File
.env.sentry-build-plugin

# Local tooling artifacts
.playwright-cli/
/output/
