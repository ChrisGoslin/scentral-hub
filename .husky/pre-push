#!/bin/sh
# Pre-push hook: type-check + module-scope-client guard + image hostname guard
#
# Catches:
# 1. Missing imports, bad types (tsc --noEmit)
# 2. Module-level createClient() calls that throw at build time (see L15)
# 3. External image hostnames declared in scripts but missing from next.config.ts (see L16)
#
# Fast path: ~15-20s instead of full `npm run build` (~60s).
# For full build + e2e verification, run before major changes:
#   npm run build && npm run test:e2e -- --project=chromium

current_branch=$(git symbolic-ref HEAD 2>/dev/null | sed 's|refs/heads/||')

if [ "$current_branch" != "main" ]; then
  exit 0
fi

echo "🔍 Type-checking before push to main..."
npx tsc --noEmit
TSC_STATUS=$?

echo "🔍 Checking for module-level createClient() in app/api routes..."
# Column-0 match only - a createClient() call indented inside any function (helper
# or handler) is fine; true module scope in this codebase is always unindented.
BAD_FILES=$(grep -rl "^const [A-Za-z_][A-Za-z0-9_]* = \(await \)\?createClient(" app/api --include="*.ts" 2>/dev/null)

if [ -n "$BAD_FILES" ]; then
  echo "❌ Module-level createClient() found (throws if env vars are missing at build time):"
  for f in $BAD_FILES; do echo "   - $f"; done
  echo "   Move createClient() inside the handler function instead."
fi

# Image hostname whitelist check — prevents next/image runtime crashes.
#
# Convention: any script that writes image_url values sourced from an external CDN must
# declare its domain(s) via a top-of-file comment:
#   // @image-domains: upload.wikimedia.org media.parfumo.com
#
# This hook reads those declarations and verifies each domain is in next.config.ts
# remotePatterns. next/image throws at RENDER time (not build time) on unconfigured
# hostnames — the error is silent to tsc/build but crashes the page for all users.
# Failure that prompted this check: Wikidata backfill, 2026-06-28 (AGENTS.md L16).
echo "🔍 Checking image hostname whitelist..."
IMAGE_HOST_FAILED=0
DECLARED_HOSTS=$(grep -rh "@image-domains:" scripts/ --include="*.mjs" --include="*.ts" 2>/dev/null |
  sed 's/.*@image-domains://' |
  tr ' ' '\n' |
  sed 's|//||g' |
  grep -v '^$' |
  sort -u)
if [ -n "$DECLARED_HOSTS" ]; then
  CONFIG_HOSTS=$(grep -oE "'[^']+'" lib/fragranceImageHosts.* 2>/dev/null | sed "s/'//g")
  for host in $DECLARED_HOSTS; do
    if ! echo "$CONFIG_HOSTS" | grep -qF "$host"; then
      echo "❌ Image hostname '$host' is declared in a script @image-domains comment but missing from next.config.ts remotePatterns."
      echo "   next/image will throw at runtime. Add: { protocol: 'https', hostname: '$host' } to remotePatterns."
      IMAGE_HOST_FAILED=1
    fi
  done
fi

# Lesson-ID integrity (L47) — a duplicate ID silently retargets every citation to it.
echo "🔍 Checking lesson-ID integrity..."
LESSON_ID_FAILED=0
if [ -f docs/lessons.md ]; then
  UNIQUE_IDS=$(grep -oE "^### L[0-9]+" docs/lessons.md | sort -u | wc -l | tr -d ' ')
  TOTAL_IDS=$(grep -cE "^### L[0-9]+" docs/lessons.md | tr -d ' ')
  if [ "$UNIQUE_IDS" -ne "$TOTAL_IDS" ]; then
    echo "❌ $((TOTAL_IDS - UNIQUE_IDS)) duplicate lesson IDs in docs/lessons.md."
    LESSON_ID_FAILED=1
  fi
fi

# Dead canon pointers (GL-3, GL-7) — ~/.claude/*.md is unreachable from Cowork and has
# silently broken grounding twice; canon must route through claude-global/ instead.
# Scoped to the actual canon-routing surface (docs/index.md, CLAUDE.md, AGENTS.md),
# not all of docs/ — a full-tree scan false-positives on historical handover docs that
# narrate the incident itself (they must quote the bad path to describe it) and on
# already-archived stubs under docs/archived/. Narrowed 2026-08-03 after the literal
# docs/-wide check specified in the original prompt hit exactly those false positives
# on first run.
echo "🔍 Checking for dead canon pointers..."
ROUTING_DOCS="docs/index.md CLAUDE.md AGENTS.md"
DEAD_POINTERS=""
for f in $ROUTING_DOCS; do
  if [ -f "$f" ] && grep -qE '~/\.claude/[A-Za-z0-9_./-]*\.md|/Users/[^/]+/\.claude/[A-Za-z0-9_./-]*\.md' "$f" 2>/dev/null; then
    DEAD_POINTERS="$DEAD_POINTERS $f"
  fi
done
if [ -n "$DEAD_POINTERS" ]; then
  echo "❌ Dead canon pointer(s) to ~/.claude/*.md found in routing docs (unreachable from Cowork):"
  for f in $DEAD_POINTERS; do echo "   - $f"; done
fi

# Skill tree parity (L46) — warn only, do not block. Exclusions recorded in
# .claude/skills/README.md are expected gaps, not drift.
echo "🔍 Checking skill tree parity (warn only)..."
if [ -d .claude/skills ]; then
  ls .claude/skills 2>/dev/null | sort > /tmp/pre-push-claude-skills.$$
  ls .agents/skills 2>/dev/null | sort > /tmp/pre-push-agents-skills.$$
  ls .gemini/skills 2>/dev/null | sort > /tmp/pre-push-gemini-skills.$$
  MISSING_AGENTS=$(comm -23 /tmp/pre-push-claude-skills.$$ /tmp/pre-push-agents-skills.$$ | grep -v '^README.md$')
  MISSING_GEMINI=$(comm -23 /tmp/pre-push-claude-skills.$$ /tmp/pre-push-gemini-skills.$$ | grep -v '^README.md$')
  rm -f /tmp/pre-push-claude-skills.$$ /tmp/pre-push-agents-skills.$$ /tmp/pre-push-gemini-skills.$$
  if [ -n "$MISSING_AGENTS" ] || [ -n "$MISSING_GEMINI" ]; then
    echo "⚠️  Skill tree drift detected (not blocking) — check .claude/skills/README.md for known exclusions:"
    [ -n "$MISSING_AGENTS" ] && echo "$MISSING_AGENTS" | sed 's/^/   .agents missing: /'
    [ -n "$MISSING_GEMINI" ] && echo "$MISSING_GEMINI" | sed 's/^/   .gemini missing: /'
  fi
fi

if [ $TSC_STATUS -ne 0 ] || [ -n "$BAD_FILES" ] || [ $IMAGE_HOST_FAILED -ne 0 ] || [ $LESSON_ID_FAILED -ne 0 ] || [ -n "$DEAD_POINTERS" ]; then
  echo "❌ Pre-push checks failed — push blocked. Fix errors above before pushing."
  exit 1
fi

echo "✅ Pre-push checks passed — pushing."
exit 0
