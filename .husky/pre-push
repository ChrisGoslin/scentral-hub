#!/bin/sh
# Pre-push hook: type-check + module-scope-client guard + image hostname guard
#
# Catches:
# 1. Missing imports, bad types (tsc --noEmit)
# 2. Module-level createClient() calls that throw at build time (see L15)
# 3. External image hostnames declared in scripts but missing from next.config.ts (see L16)
#
# Fast path: ~15-20s instead of full `npm run build` (~60s).
# For full build + e2e verification, run before major changes:
#   npm run build && npm run test:e2e -- --project=chromium

current_branch=$(git symbolic-ref HEAD 2>/dev/null | sed 's|refs/heads/||')

# Skill integrity check runs on every branch, not just main — a skill compromise
# can land via any branch that later merges (see docs/lessons.md L26-L29).
echo "🔍 Checking skill file integrity..."
node "$(git rev-parse --show-toplevel)/scripts/check-skill-integrity.mjs"
SKILL_INTEGRITY_STATUS=$?
if [ $SKILL_INTEGRITY_STATUS -ne 0 ]; then
  echo "❌ Pre-push checks failed — push blocked. Fix errors above before pushing."
  exit 1
fi

# Lesson-ID uniqueness check runs on every branch too — the collision this guards
# against (two sessions independently reusing the same L<n>) is a doc-authoring
# mistake, not a main-branch-only concern (see docs/lessons.md L45).
echo "🔍 Checking docs/lessons.md for duplicate lesson IDs..."
node "$(git rev-parse --show-toplevel)/scripts/check-lesson-ids.mjs"
LESSON_ID_STATUS=$?
if [ $LESSON_ID_STATUS -ne 0 ]; then
  echo "❌ Pre-push checks failed — push blocked. Fix errors above before pushing."
  exit 1
fi

# Handover script-reference check (L76) — a handover citing `npm run <script>`
# that doesn't exist in package.json is an unrunnable, unverified claim by
# construction. Runs on every branch, same reasoning as the two checks above.
echo "🔍 Checking handover docs for nonexistent npm script references..."
node "$(git rev-parse --show-toplevel)/scripts/check-handover-scripts.mjs"
HANDOVER_SCRIPT_STATUS=$?
if [ $HANDOVER_SCRIPT_STATUS -ne 0 ]; then
  echo "❌ Pre-push checks failed — push blocked. Fix errors above before pushing."
  exit 1
fi

# Canon uniqueness check (L77) — canon is cited by bare filename, so two files
# sharing a canon name means every citation is ambiguous. Runs on every branch:
# a fork lands via whatever branch created it, and merges to main afterwards.
echo "🔍 Checking canon filename uniqueness..."
node "$(git rev-parse --show-toplevel)/scripts/check-canon-uniqueness.mjs"
CANON_UNIQUE_STATUS=$?
if [ $CANON_UNIQUE_STATUS -ne 0 ]; then
  echo "❌ Pre-push checks failed — push blocked. Fix errors above before pushing."
  exit 1
fi

# Performance-criteria check (L79/L80) — also a CI job, but CI catches it after the
# push. It caught exactly this on 2026-08-22: the canon de-duplication deleted a doc
# this check reads, and the mobile LCP budget silently reverted to a retired value.
# Four file reads, so there is no reason for it to live only in CI.
echo "🔍 Checking performance criteria consistency..."
node "$(git rev-parse --show-toplevel)/scripts/check-performance-criteria.mjs"
PERF_CRITERIA_STATUS=$?
if [ $PERF_CRITERIA_STATUS -ne 0 ]; then
  echo "❌ Pre-push checks failed — push blocked. Fix errors above before pushing."
  exit 1
fi

if [ "$current_branch" != "main" ]; then
  exit 0
fi

echo "🔍 Type-checking before push to main..."
npx tsc --noEmit
TSC_STATUS=$?

echo "🔍 Checking for module-level createClient() in app/api routes..."
# Column-0 match only - a createClient() call indented inside any function (helper
# or handler) is fine; true module scope in this codebase is always unindented.
BAD_FILES=$(grep -rl "^const [A-Za-z_][A-Za-z0-9_]* = \(await \)\?createClient(" app/api --include="*.ts" 2>/dev/null)

if [ -n "$BAD_FILES" ]; then
  echo "❌ Module-level createClient() found (throws if env vars are missing at build time):"
  for f in $BAD_FILES; do echo "   - $f"; done
  echo "   Move createClient() inside the handler function instead."
fi

# Image hostname whitelist check — prevents next/image runtime crashes.
#
# Convention: any script that writes image_url values sourced from an external CDN must
# declare its domain(s) via a top-of-file comment:
#   // @image-domains: upload.wikimedia.org media.parfumo.com
#
# This hook reads those declarations and verifies each domain is in next.config.ts
# remotePatterns. next/image throws at RENDER time (not build time) on unconfigured
# hostnames — the error is silent to tsc/build but crashes the page for all users.
# Failure that prompted this check: Wikidata backfill, 2026-06-28 (AGENTS.md L16).
echo "🔍 Checking image hostname whitelist..."
IMAGE_HOST_FAILED=0
DECLARED_HOSTS=$(grep -rh "@image-domains:" scripts/ --include="*.mjs" --include="*.ts" 2>/dev/null |
  sed 's/.*@image-domains://' |
  tr ' ' '\n' |
  sed 's|//||g' |
  grep -v '^$' |
  sort -u)
if [ -n "$DECLARED_HOSTS" ]; then
  CONFIG_HOSTS=$(grep -oE "'[^']+'" lib/fragranceImageHosts.* 2>/dev/null | sed "s/'//g")
  for host in $DECLARED_HOSTS; do
    if ! echo "$CONFIG_HOSTS" | grep -qF "$host"; then
      echo "❌ Image hostname '$host' is declared in a script @image-domains comment but missing from next.config.ts remotePatterns."
      echo "   next/image will throw at runtime. Add: { protocol: 'https', hostname: '$host' } to remotePatterns."
      IMAGE_HOST_FAILED=1
    fi
  done
fi

# Lesson-ID integrity (L47) — a duplicate ID silently retargets every citation to it.
echo "🔍 Checking lesson-ID integrity..."
LESSON_ID_FAILED=0
if [ -f docs/lessons.md ]; then
  UNIQUE_IDS=$(grep -oE "^### L[0-9]+" docs/lessons.md | sort -u | wc -l | tr -d ' ')
  TOTAL_IDS=$(grep -cE "^### L[0-9]+" docs/lessons.md | tr -d ' ')
  if [ "$UNIQUE_IDS" -ne "$TOTAL_IDS" ]; then
    echo "❌ $((TOTAL_IDS - UNIQUE_IDS)) duplicate lesson IDs in docs/lessons.md."
    LESSON_ID_FAILED=1
  fi
fi

# Dead canon pointers (GL-3, GL-7) — ~/.claude/*.md is unreachable from Cowork and has
# silently broken grounding twice; canon must route through claude-global/ instead.
#
# Auto-discovers routing docs instead of a fixed list (2026-08-03, after a fixed
# 3-file list missed a real stale pointer in docs/launch/). Scans all of docs/ plus
# CLAUDE.md/AGENTS.md, excluding docs/archived/ (explicitly superseded) and dated
# historical incident narratives (HANDOVER-YYYY-MM-DD-*.md, *verification-audit*.md)
# that must quote a bad path to document it. Safe against false positives because the
# regex below is narrow — it matches only the four actual canon filenames
# (CLAUDE/PROJECTS/LESSONS/profile.md), not any ~/.claude/* path, so it does not flag
# legitimate paths like ~/.claude/plugins/... or ~/.claude/skills/... (GL-3/GL-7 is
# about those four files moving to claude-global/, not about ~/.claude/ categorically).
echo "🔍 Checking for dead canon pointers..."
ROUTING_DOCS="CLAUDE.md AGENTS.md"
ROUTING_DOCS="$ROUTING_DOCS $(find docs -name '*.md' \
  -not -path '*/archived/*' \
  -not -name 'HANDOVER-????-??-??-*.md' \
  -not -name '*verification-audit*.md' 2>/dev/null)"
DEAD_POINTERS=""
for f in $ROUTING_DOCS; do
  if [ -f "$f" ] && grep -qiE '~/\.claude/(CLAUDE|PROJECTS|LESSONS|profile)\.md|/Users/[^/]+/\.claude/(CLAUDE|PROJECTS|LESSONS|profile)\.md' "$f" 2>/dev/null; then
    DEAD_POINTERS="$DEAD_POINTERS $f"
  fi
done
if [ -n "$DEAD_POINTERS" ]; then
  echo "❌ Dead canon pointer(s) to ~/.claude/*.md found in routing docs (unreachable from Cowork):"
  for f in $DEAD_POINTERS; do echo "   - $f"; done
fi

# Skill tree parity (L46) — warn only, do not block. Exclusions are read directly
# from .claude/skills/README.md's machine-readable block (between the
# pre-push-skill-parity-exclusions markers) instead of a second hardcoded list —
# Critique 2 (2026-08-03) found a hardcoded copy here drifted from the README's
# prose immediately (the filter never read the documented exclusion at all).
# Single source of truth now: edit the README block, this hook picks it up.
echo "🔍 Checking skill tree parity (warn only)..."
if [ -d .claude/skills ]; then
  EXCLUDED_SKILLS="README.md"
  if [ -f .claude/skills/README.md ]; then
    README_EXCLUSIONS=$(sed -n '/<!-- pre-push-skill-parity-exclusions:start -->/,/<!-- pre-push-skill-parity-exclusions:end -->/p' .claude/skills/README.md \
      | grep -v '^<!--' | grep -v '^$' | tr '\n' '|' | sed 's/|$//')
    [ -n "$README_EXCLUSIONS" ] && EXCLUDED_SKILLS="$EXCLUDED_SKILLS|$README_EXCLUSIONS"
  fi
  ls .claude/skills 2>/dev/null | sort > /tmp/pre-push-claude-skills.$$
  ls .agents/skills 2>/dev/null | sort > /tmp/pre-push-agents-skills.$$
  ls .gemini/skills 2>/dev/null | sort > /tmp/pre-push-gemini-skills.$$
  MISSING_AGENTS=$(comm -23 /tmp/pre-push-claude-skills.$$ /tmp/pre-push-agents-skills.$$ | grep -vE "^($EXCLUDED_SKILLS)\$")
  MISSING_GEMINI=$(comm -23 /tmp/pre-push-claude-skills.$$ /tmp/pre-push-gemini-skills.$$ | grep -vE "^($EXCLUDED_SKILLS)\$")
  rm -f /tmp/pre-push-claude-skills.$$ /tmp/pre-push-agents-skills.$$ /tmp/pre-push-gemini-skills.$$
  if [ -n "$MISSING_AGENTS" ] || [ -n "$MISSING_GEMINI" ]; then
    echo "⚠️  Skill tree drift detected (not blocking) — check .claude/skills/README.md for known exclusions:"
    [ -n "$MISSING_AGENTS" ] && echo "$MISSING_AGENTS" | sed 's/^/   .agents missing: /'
    [ -n "$MISSING_GEMINI" ] && echo "$MISSING_GEMINI" | sed 's/^/   .gemini missing: /'
  fi
fi

if [ $TSC_STATUS -ne 0 ] || [ -n "$BAD_FILES" ] || [ $IMAGE_HOST_FAILED -ne 0 ] || [ $LESSON_ID_FAILED -ne 0 ] || [ -n "$DEAD_POINTERS" ]; then
  echo "❌ Pre-push checks failed — push blocked. Fix errors above before pushing."
  exit 1
fi

echo "✅ Pre-push checks passed — pushing."
exit 0
