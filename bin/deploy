#!/bin/bash

# bin/deploy — guarded deployment script for the nota. web app
# Enforces pre-flight checks before pushing to production

set -e

CURRENT_BRANCH=$(git branch --show-current)
GIT_STATUS=$(git status --porcelain)

echo "🚀 nota. Deploy"
echo ""

# 1. Verify on main
if [ "$CURRENT_BRANCH" != "main" ]; then
  echo "❌ Not on main branch (currently on: $CURRENT_BRANCH)"
  echo "   Switch to main and try again:"
  echo "   git checkout main"
  exit 1
fi
echo "✓ On main branch"

# 2. Verify working tree is clean
if [ ! -z "$GIT_STATUS" ]; then
  echo "❌ Working tree has uncommitted changes:"
  echo "$GIT_STATUS"
  echo ""
  echo "   Commit or stash changes before deploying."
  exit 1
fi
echo "✓ Working tree is clean"

# 3. Build
echo ""
echo "Building..."
if ! npm run build; then
  echo ""
  echo "❌ Build failed. Fix errors and try again."
  exit 1
fi
echo "✓ Build passed"

# 4. Deploy to Vercel and wait for READY
echo ""
echo "Deploying to Vercel..."
DEPLOY_OUTPUT=$(npx vercel deploy --prod 2>&1)
if [ $? -ne 0 ]; then
  echo "❌ Vercel deploy command failed"
  echo "$DEPLOY_OUTPUT"
  exit 1
fi

# Extract the deployment URL from output
DEPLOY_URL=$(echo "$DEPLOY_OUTPUT" | grep -Eo 'https://[^[:space:]]+' | head -1)
if [ -z "$DEPLOY_URL" ]; then
  echo "❌ Could not extract deployment URL from Vercel output"
  exit 1
fi

echo "Deployment URL: $DEPLOY_URL"

# Poll for READY state
echo "Waiting for deployment to reach READY state..."
MAX_ATTEMPTS=60  # 5 minutes at 5s intervals
ATTEMPT=0

while [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do
  INSPECT_OUTPUT=$(vercel inspect "$DEPLOY_URL" --json 2>/dev/null || echo "{}")
  STATE=$(echo "$INSPECT_OUTPUT" | grep -o '"state":"[^"]*"' | grep -o '[^"]*"$' | tr -d '"')

  if [ "$STATE" = "READY" ]; then
    echo "✓ Deployment is READY"
    break
  fi

  if [ "$STATE" = "ERROR" ] || [ "$STATE" = "CANCELED" ]; then
    echo "❌ Deployment failed with state: $STATE"
    exit 1
  fi

  ATTEMPT=$((ATTEMPT + 1))
  if [ $((ATTEMPT % 6)) -eq 0 ]; then
    echo "  Still waiting... (${ATTEMPT}s elapsed)"
  fi
  sleep 5
done

if [ $ATTEMPT -eq $MAX_ATTEMPTS ]; then
  echo "❌ Deployment did not reach READY state within 5 minutes"
  exit 1
fi

# 5. Run smoke tests against the deployment just created
echo ""
echo "Running smoke tests..."
if ! NEXT_PUBLIC_SITE_URL="$DEPLOY_URL" npm run test:smoke:prod; then
  echo ""
  echo "❌ Smoke tests failed. Deployment succeeded but health check failed."
  echo "   Check https://vercel.com/dashboard for recent deployments."
  exit 1
fi

# 6. Success
echo ""
echo "✅ PASS — Deployment successful"
