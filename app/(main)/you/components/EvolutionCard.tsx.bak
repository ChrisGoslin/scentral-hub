'use client'

import { useEffect, useState } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { createClient } from '@/lib/supabase/client'
import { Button } from '@/components/ui/Button'
import { X } from 'lucide-react'

interface EvolutionEvent {
  id: string
  old_identity: string
  new_identity: string
  shift_type: 'descriptor_drift' | 'family_shift' | 'blind_ranking'
  confidence: number
  user_choice: 'stay' | 'evolve' | 'keep_both' | null
  status: 'active' | 'previous' | 'kept'
  created_at: string
}

interface NoseprintSnapshot {
  identity_json: {
    persona_id: string
    confidence: number
    detected_at: string
    reason: string
    full_circle?: string
  }
}

const PERSONA_DISPLAY = {
  velvet_intellectual: 'The Intellectual',
  solar_minimalist: 'The Minimalist',
  dark_alchemist: 'The Alchemist',
  ritual_keeper: 'The Ritual Keeper',
  rebel_experimentalist: 'The Experimentalist',
  comfort_seeker: 'The Comfort Seeker'
}

const PERSONA_DESCRIPTION = {
  velvet_intellectual: 'Sophisticated, layered, complex',
  solar_minimalist: 'Clean, bright, purposeful',
  dark_alchemist: 'Mysterious, bold, transformative',
  ritual_keeper: 'Ceremonial, grounding, intentional',
  rebel_experimentalist: 'Adventurous, unconventional, daring',
  comfort_seeker: 'Warm, familiar, calming'
}

export function EvolutionCard() {
  const [evolution, setEvolution] = useState<EvolutionEvent | null>(null)
  const [isLoading, setIsLoading] = useState(true)
  const [selectedChoice, setSelectedChoice] = useState<'stay' | 'evolve' | 'keep_both' | null>(null)
  const [isSubmitting, setIsSubmitting] = useState(false)
  const supabase = createClient()

  useEffect(() => {
    const fetchLatestEvolution = async () => {
      try {
        // Get current anon_id from localStorage
        const anonId = localStorage.getItem('scentral_anon_id')
        if (!anonId) {
          setIsLoading(false)
          return
        }

        // Fetch the most recent active evolution event
        const { data, error } = await supabase
          .from('evolution_events')
          .select('*')
          .eq('anon_id', anonId)
          .eq('status', 'active')
          .order('created_at', { ascending: false })
          .limit(1)
          .single()

        if (error && error.code !== 'PGRST116') {
          // PGRST116 = no rows found (expected)
          console.error('Error fetching evolution:', error)
        }

        if (data) {
          setEvolution(data)
        }
      } catch (err) {
        console.error('Failed to fetch evolution:', err)
      } finally {
        setIsLoading(false)
      }
    }

    fetchLatestEvolution()
  }, [])

  const handleChoice = async (choice: 'stay' | 'evolve' | 'keep_both') => {
    if (!evolution) return

    setIsSubmitting(true)
    setSelectedChoice(choice)

    try {
      const anonId = localStorage.getItem('scentral_anon_id')
      if (!anonId) return

      // Update evolution_events with user choice
      await supabase
        .from('evolution_events')
        .update({
          user_choice: choice,
          status: choice === 'keep_both' ? 'kept' : 'active'
        })
        .eq('id', evolution.id)

      // Mark the event as handled by removing it from display
      setEvolution(null)

      // Optionally, update noseprint_history status if they chose to "keep_both"
      if (choice === 'keep_both') {
        await supabase
          .from('noseprint_history')
          .update({ status: 'kept' })
          .eq('anon_id', anonId)
          .eq('status', 'previous')
          .order('created_at', { ascending: false })
          .limit(1)
      }
    } catch (err) {
      console.error('Error saving choice:', err)
      setSelectedChoice(null)
    } finally {
      setIsSubmitting(false)
    }
  }

  if (isLoading || !evolution) {
    return null
  }

  const isFullCircle = evolution.new_identity === evolution.old_identity
  const oldPersonaDisplay = PERSONA_DISPLAY[evolution.old_identity as keyof typeof PERSONA_DISPLAY] || evolution.old_identity
  const newPersonaDisplay = PERSONA_DISPLAY[evolution.new_identity as keyof typeof PERSONA_DISPLAY] || evolution.new_identity
  const newPersonaDesc = PERSONA_DESCRIPTION[evolution.new_identity as keyof typeof PERSONA_DESCRIPTION]

  return (
    <AnimatePresence>
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        exit={{ opacity: 0, y: -20 }}
        transition={{ duration: 0.6, ease: [0.16, 1, 0.3, 1] }}
        className="w-full max-w-2xl mx-auto mb-8"
      >
        <div className="relative bg-gradient-to-br from-[var(--moss-1)] to-[var(--moss-2)] border border-[var(--moss-border)] rounded-3xl p-8 shadow-lg overflow-hidden">
          {/* Subtle animated background glow */}
          <motion.div
            className="absolute inset-0 bg-radial-gradient opacity-30"
            animate={{ scale: [1, 1.05, 1] }}
            transition={{ duration: 4, repeat: Infinity }}
            style={{
              background:
                'radial-gradient(circle at 30% 50%, var(--moss-accent) 0%, transparent 50%)'
            }}
          />

          {/* Close button */}
          <button
            onClick={() => setEvolution(null)}
            className="absolute top-6 right-6 p-2 hover:bg-white/10 rounded-full transition-colors z-10"
            aria-label="Close"
          >
            <X size={20} className="text-[var(--text)]" />
          </button>

          <div className="relative z-10">
            {/* Header */}
            <div className="mb-6">
              {isFullCircle ? (
                <>
                  <p className="text-sm text-[var(--text-muted)] mb-2 font-serif italic">
                    A familiar return
                  </p>
                  <h2 className="text-3xl font-serif text-[var(--text)] mb-2">
                    You're circling back
                  </h2>
                  <p className="text-[var(--text-muted)]">
                    Your scent identity is returning to <span className="font-semibold">{oldPersonaDisplay}</span>. No judgment—evolution is a spiral, not a line.
                  </p>
                </>
              ) : (
                <>
                  <p className="text-sm text-[var(--text-muted)] mb-2 font-serif italic">
                    Your nose is shifting
                  </p>
                  <h2 className="text-3xl font-serif text-[var(--text)] mb-2">
                    Something's shifted
                  </h2>
                  <p className="text-[var(--text-muted)] mb-4">
                    You were <span className="font-semibold">{oldPersonaDisplay}</span> →
                    leaning toward <span className="font-semibold">{newPersonaDisplay}</span>
                  </p>
                </>
              )}
            </div>

            {/* Persona cards */}
            <div className="grid grid-cols-2 gap-4 mb-6">
              {/* Old identity */}
              <div className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-4">
                <p className="text-xs text-[var(--text-muted)] uppercase tracking-wide mb-1">
                  Before
                </p>
                <p className="text-lg font-serif text-[var(--text)]">{oldPersonaDisplay}</p>
              </div>

              {/* Arrow or divider */}
              <div className="flex items-center justify-center">
                <motion.div
                  animate={{ x: [0, 4, 0] }}
                  transition={{ duration: 2, repeat: Infinity }}
                  className="text-[var(--moss-accent)] text-xl"
                >
                  →
                </motion.div>
              </div>

              {/* New identity */}
              <div className="col-span-2 bg-[var(--moss-accent)]/20 backdrop-blur-sm border border-[var(--moss-accent)]/30 rounded-2xl p-4">
                <p className="text-xs text-[var(--text-muted)] uppercase tracking-wide mb-1">
                  Emerging
                </p>
                <p className="text-lg font-serif text-[var(--text)]">{newPersonaDisplay}</p>
                <p className="text-sm text-[var(--text-muted)] mt-2 italic">{newPersonaDesc}</p>
                <div className="mt-3 flex items-center gap-2">
                  <div className="flex-1 h-2 bg-white/10 rounded-full overflow-hidden">
                    <motion.div
                      className="h-full bg-gradient-to-r from-[var(--moss-accent)] to-[var(--xp-color)]"
                      initial={{ width: '0%' }}
                      animate={{ width: `${evolution.confidence}%` }}
                      transition={{ duration: 1, ease: 'easeOut' }}
                    />
                  </div>
                  <span className="text-xs font-semibold text-[var(--text)]">
                    {evolution.confidence}%
                  </span>
                </div>
              </div>
            </div>

            {/* Reason */}
            <div className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-3 mb-6">
              <p className="text-xs text-[var(--text-muted)] uppercase tracking-wide mb-1">
                What changed
              </p>
              <p className="text-sm text-[var(--text)]">{evolution.shift_type === 'family_shift' ? '👨‍👧‍👦 ' : '🧪 '}{evolution.shift_type === 'family_shift' ? 'Family distribution shifted' : 'New descriptor patterns emerged'}</p>
            </div>

            {/* Choices */}
            <div className="grid grid-cols-1 gap-3">
              <Button
                onClick={() => handleChoice('evolve')}
                disabled={isSubmitting}
                className={`w-full bg-gradient-to-r from-[var(--moss-accent)] to-[var(--xp-color)] text-white font-semibold py-3 rounded-xl transition-all ${
                  selectedChoice === 'evolve' ? 'scale-95 opacity-80' : 'hover:shadow-lg'
                }`}
              >
                {isSubmitting && selectedChoice === 'evolve' ? 'Updating...' : 'Evolve to ' + newPersonaDisplay}
              </Button>

              <Button
                onClick={() => handleChoice('keep_both')}
                disabled={isSubmitting}
                className={`w-full bg-white/10 text-[var(--text)] border border-white/20 font-semibold py-3 rounded-xl transition-all ${
                  selectedChoice === 'keep_both' ? 'scale-95 opacity-80' : 'hover:bg-white/20'
                }`}
              >
                {isSubmitting && selectedChoice === 'keep_both'
                  ? 'Keeping...'
                  : 'Keep both—I'm in transition'}
              </Button>

              <Button
                onClick={() => handleChoice('stay')}
                disabled={isSubmitting}
                className={`w-full bg-transparent text-[var(--text-muted)] border border-white/10 font-semibold py-3 rounded-xl transition-all ${
                  selectedChoice === 'stay' ? 'scale-95 opacity-80' : 'hover:bg-white/5'
                }`}
              >
                {isSubmitting && selectedChoice === 'stay' ? 'Keeping...' : 'Stay as ' + oldPersonaDisplay}
              </Button>
            </div>

            {/* Footer copy */}
            <p className="text-xs text-[var(--text-muted)] text-center mt-6 font-serif italic">
              No pressure. Your taste will keep evolving—we'll be here to track it.
            </p>
          </div>
        </div>
      </motion.div>
    </AnimatePresence>
  )
}
